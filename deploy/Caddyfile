# HTTPS in front of the Xerp API. Caddy obtains and renews the certificate for XERP_DOMAIN itself
# (ports 80 and 443 must be reachable from the internet, and DNS must point at this machine).
# Caddy replaces any X-Forwarded-For sent by a client with the real client address.
{$XERP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy api:8000
}
