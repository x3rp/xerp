# Copy to .env to override the dev defaults in compose.yaml.
POSTGRES_USER=xerp
POSTGRES_PASSWORD=xerp
POSTGRES_DB=xerp
XERP_API_PORT=8000
# Platform admin key (Authorization: Bearer <key>) for /api/v1/admin/*. At least 32 characters,
# e.g. `openssl rand -base64 32`. Left empty, admin routes reject every request.
XERP_ADMIN_KEY=

# --- Production only (compose.prod.yaml); see docs/deployment.md ---
# Public host name of the API; Caddy gets an HTTPS certificate for it. DNS must point at this machine.
XERP_DOMAIN=
# Requests per minute per client address on /api/v1 and /mcp (0 = no limit).
XERP_RATE_LIMIT_PER_MINUTE=600
# Where the daily dumps go, and how many days they are kept.
XERP_BACKUP_DIR=./backups
XERP_BACKUP_KEEP_DAYS=14

# --- Home server over Tailscale (compose.tailscale.yaml); see docs/deployment.md ---
# COMPOSE_FILE=compose.yaml:compose.tailscale.yaml
# XERP_DOMAIN is not used; XERP_RATE_LIMIT_PER_MINUTE defaults to 0 there.
